<Project Sdk="Microsoft.NET.Sdk">
  <!-- Pure rules engine: state, move generation, turn resolution, content, AI. Must not reference Godot. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>RogueChess.Engine</RootNamespace>
    <AssemblyName>RogueChess.Engine</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="RogueChess.Engine.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- Handmade rosters (repo root rosters/*.json) ship inside the engine; see RosterJson.AddEmbeddedRosters. -->
    <EmbeddedResource Include="../../rosters/*.json" LogicalName="rosters/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
